DATABASE_URL=postgresql+psycopg://astra:astra@localhost:5432/astra

# Основной источник данных приложения
DATA_SOURCE=dummy

# Источник временной истории для ML
ML_DATA_SOURCE=dummy

# New file uploads use the pipeline regardless of the legacy data source mode.
ML_SERVICE_URL=http://127.0.0.1:9000
# DATASET_UPLOAD_DIR=/path/to/persistent/uploads
# DATASET_MAX_UPLOAD_BYTES=68719476736
# Independent SQL workers per import (1–8); start with 2 on a 16 GB machine.
DATASET_BUILD_WORKERS=auto
# PostgreSQL work_mem per sort/hash operation, not a total worker memory limit.
DATASET_WORK_MEM_MB=64
# Conservative peak disk estimate, including staging, indexes and uploaded CSV.
DATASET_STORAGE_EXPANSION_FACTOR=8
